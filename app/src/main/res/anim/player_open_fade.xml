<?xml version="1.0" encoding="utf-8"?>
<!-- Player open: fast fade only, no slide translation. The black
     windowBackground underneath acts as the instant coating, so the video
     surface is revealed the moment the first frame is ready. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="150"
    android:fromAlpha="0.0"
    android:toAlpha="1.0" />
